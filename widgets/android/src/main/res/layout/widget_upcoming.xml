                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary"
                android:text="" />

            <!-- 부제(장소/시각). 없으면 provider 가 GONE 으로 만든다. -->
            <TextView
                android:id="@+id/row1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>

        <!-- 문서유형 색 점 -->
        <ImageView
            android:id="@+id/row1_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_default"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 항목 3. 데이터가 부족하면 provider 가 이 행 전체를 GONE 으로 만든다. -->
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/widget_row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- D-day 배지. 배경 drawable 은 임박(<=3일) 여부에 따라 런타임에 바뀐다. -->
        <TextView
            android:id="@+id/row2_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:background="@drawable/widget_badge_normal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_action"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary"
                android:text="" />

            <!-- 부제(장소/시각). 없으면 provider 가 GONE 으로 만든다. -->
            <TextView
                android:id="@+id/row2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>

        <!-- 문서유형 색 점 -->
        <ImageView
            android:id="@+id/row2_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_default"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 항목 4. 데이터가 부족하면 provider 가 이 행 전체를 GONE 으로 만든다. -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/widget_row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- D-day 배지. 배경 drawable 은 임박(<=3일) 여부에 따라 런타임에 바뀐다. -->
        <TextView
            android:id="@+id/row3_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:background="@drawable/widget_badge_normal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_action"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary"
                android:text="" />

            <!-- 부제(장소/시각). 없으면 provider 가 GONE 으로 만든다. -->
            <TextView
                android:id="@+id/row3_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>

        <!-- 문서유형 색 점 -->
        <ImageView
            android:id="@+id/row3_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_default"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 항목 5. 데이터가 부족하면 provider 가 이 행 전체를 GONE 으로 만든다. -->
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/widget_row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- D-day 배지. 배경 drawable 은 임박(<=3일) 여부에 따라 런타임에 바뀐다. -->
        <TextView
            android:id="@+id/row4_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:background="@drawable/widget_badge_normal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_action"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary"
                android:text="" />

            <!-- 부제(장소/시각). 없으면 provider 가 GONE 으로 만든다. -->
            <TextView
                android:id="@+id/row4_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>

        <!-- 문서유형 색 점 -->
        <ImageView
            android:id="@+id/row4_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_default"
            android:contentDescription="@null" />
    </LinearLayout>
    </LinearLayout>

    <!-- 빈 상태. 탭 → mora://scan -->
    <TextView
        android:id="@+id/upcoming_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:text="@string/widget_upcoming_empty" />
</LinearLayout>
