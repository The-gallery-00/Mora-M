<?xml version="1.0" encoding="utf-8"?>
<!--
  MORA 다가오는 일정 위젯 (4x2 / 4x4 리사이즈).

  RemoteViews 제약
    - ConstraintLayout 은 지원되지 않는다. LinearLayout/RelativeLayout/FrameLayout/GridLayout 만 쓴다.
    - @RemoteView 가 붙지 않은 뷰(<View>, <Space>)는 인플레이트가 거부될 수 있어 쓰지 않는다.
      구분선도 ImageView 의 background 로 그린다.
    - 항목 개수를 동적으로 늘릴 수 없으므로 **행 5개를 미리 정의**하고 남는 행은 GONE 으로 접는다.
      표시 개수는 위젯 높이(4x2=3개 / 4x3=4개 / 4x4=5개)로 결정된다 — UpcomingWidgetProvider.
    - 리스트/빈 상태 둘 다 layout_weight=1 이다. GONE 인 자식은 가중치 배분에서 제외되므로
      보이는 쪽이 남은 높이를 전부 차지한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/upcoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 헤더: 로고 + 워드마크 + 오늘 날짜 + 새로고침. 헤더 탭 → mora:// (앱 홈) -->
    <LinearLayout
        android:id="@+id/upcoming_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <!-- expo prebuild 가 app.config.js adaptiveIcon.foregroundImage 에서 생성하는 에셋.
             108dp 캔버스 중앙 66dp 에 로고가 들어 있어 작은 크기에서도 잘리지 않는다. -->
        <ImageView
            android:id="@+id/upcoming_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_foreground"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/upcoming_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_brand"
            android:text="MORA" />

        <TextView
            android:id="@+id/upcoming_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right|center_vertical"
            android:maxLines="1"
            android:textSize="11sp"
            android:textColor="@color/widget_text_muted"
            android:text="" />

        <!-- 30분 주기 갱신을 기다리지 않고 파일을 다시 읽는 버튼(자체 브로드캐스트).
             글리프는 U+21BB. 폰트에 없으면 작은 사각형으로 떨어지지만 동작에는 영향이 없다. -->
        <TextView
            android:id="@+id/upcoming_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="2dp"
            android:textSize="13sp"
            android:textColor="@color/widget_text_muted"
            android:contentDescription="@string/widget_refresh"
            android:text="↻" />
    </LinearLayout>

    <!-- 구분선 (border.subtle 1dp) -->
    <ImageView
        android:id="@+id/upcoming_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_border_subtle"
        android:contentDescription="@null" />

    <!-- 항목 목록.
         XML 기본값은 '빈 상태'다 — 목록/행이 GONE, 아래 안내 문구가 VISIBLE.
         initialLayout(위젯을 놓은 직후)과 previewLayout(API 31+ 위젯 선택기)이 이 레이아웃을
         그대로 렌더하므로, 기본값에 가짜 일정을 넣어 두면 선택기와 첫 프레임에 없는 데이터가 보인다.
         provider 는 매 갱신마다 모든 행의 가시성을 명시적으로 다시 지정한다. -->
    <LinearLayout
        android:id="@+id/upcoming_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

    <!-- 항목 1. 데이터가 부족하면 provider 가 이 행 전체를 GONE 으로 만든다. -->
    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/widget_row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- D-day 배지. 배경 drawable 은 임박(<=3일) 여부에 따라 런타임에 바뀐다. -->
        <TextView
            android:id="@+id/row0_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:background="@drawable/widget_badge_normal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_action"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="@color/widget_text_primary"
                android:text="" />

            <!-- 부제(장소/시각). 없으면 provider 가 GONE 으로 만든다. -->
            <TextView
                android:id="@+id/row0_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:text="" />
        </LinearLayout>

        <!-- 문서유형 색 점 -->
        <ImageView
            android:id="@+id/row0_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_default"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 항목 2. 데이터가 부족하면 provider 가 이 행 전체를 GONE 으로 만든다. -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
