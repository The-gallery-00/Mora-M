# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — LAN IP 는 PC 마다 다르므로 커밋하지 않는다 (.env.example 만 공유)
.env
.env*.local

# export 산출물
.export/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# 빌드 산출물 — APK/AAB 는 언제든 다시 만든다. GitHub 는 100MB 초과 파일을 거부한다.
*.apk
*.aab
target/

# 레포 스냅샷 zip. 워킹트리에 `MORA_mobile.zip`(193MB) 이 untracked 로 놓여 있어
# `git add .` 한 번이면 그대로 커밋에 들어간다 — GitHub 100MB 상한에 걸려 push 가 막히고,
# 되돌리려면 히스토리 재작성이 필요하다. 커밋해야 하는 zip 이 생기면 `git add -f` 로 명시할 것.
*.zip

# Python bytecode/cache
__pycache__/
*.py[cod]

# LAN 개발 모드에서 OCR 이 업로드 원본을 여기에 쌓는다 (GCS_BUCKET_NAME 미설정 시).
# 배포 환경은 GCS 를 쓰므로 이 디렉터리는 순수 로컬 산출물이다.
server/uploads/

# Obsidian 로컬 설정 (workspace.json 에 개인 경로가 들어간다)
.obsidian/

# OCR 벤치 산출물 (bench_dataset.py)
server/ocr/work_full/
server/ocr/bench_full.json
server/ocr/work_cls/
server/ocr/work_gt/

# 포스터 OCR 캐시 — tools/cache_poster_ocr.py 로 재생성한다(1MB, 이미지는 별도 저장소).
tools/poster_ocr_cache.json
tools/_ocr_cache_work/
