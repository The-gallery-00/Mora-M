# MORA Mobile 환경변수
#
# 이 파일을 .env 로 복사한 뒤 개발 PC 의 LAN IP 로 값을 채운다.
# EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 주입된다 (= 비밀값을 넣지 말 것).
#
# PC IP 확인:  ipconfig  →  "IPv4 주소" (예: 192.168.0.10)
# 두 서버는 반드시 0.0.0.0 에 바인딩되어야 폰에서 접근된다.
#   Spring:  --server.address=0.0.0.0
#   OCR:     uvicorn app:app --host 0.0.0.0 --port 8000
#
# 값을 안 채우면 안드로이드 에뮬레이터용 주소(10.0.2.2)로 폴백한다.
# 설치된 APK 에서는 진단 화면(SCR-31)에서 런타임으로 덮어쓸 수 있다.

EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
EXPO_PUBLIC_OCR_URL=http://192.168.0.10:8000

# OAuth 딥링크 사용: 서버 FRONTEND_URL 이 mora://auth 로 설정된 빌드에서만 1로 둔다.
EXPO_PUBLIC_OAUTH_DEEPLINK=0

# 목 모드: 1 이면 서버 없이 앱 내부 목 응답으로 전 화면이 동작한다 (0 = 실서버, 기본값).
# 빌드 후에도 설정 > 개발 > 목 모드 화면에서 런타임으로 켜고 끌 수 있다(런타임 값이 우선).
EXPO_PUBLIC_MOCK=0
